#!/bin/zsh
# hark-viewer [workspace] [title words...]   record a call and open the live transcript page
# hark-viewer open                           open the page without recording
# hark-viewer stop                           stop and save the call being recorded
# hark-viewer quit                           stop the call, the page server and the hark agent
# hark-viewer relabel [call] [options]       fix the speaker labels of a finished call
#
# Settings come from the environment or ~/.config/hark-viewer.env:
#   HARK_BIN, HARK_VIEWER_ROOT, HARK_VIEWER_PORT, HARK_VIEWER_BROWSER
set -euo pipefail

here="${0:A:h}"
# Optional local settings, so a checkout stays generic: HARK_BIN, HARK_VIEWER_PORT, …
cfg="${HARK_VIEWER_CONFIG:-$HOME/.config/hark-viewer.env}"
[[ -f "$cfg" ]] && source "$cfg"
export HARK_VIEWER_ROOT="${HARK_VIEWER_ROOT:-$HOME/Recordings/calls}"
export HARK_VIEWER_PORT="${HARK_VIEWER_PORT:-8474}"
export HARK_BIN="${HARK_BIN:-hark}"
base="http://127.0.0.1:$HARK_VIEWER_PORT"
api() { curl -sS --noproxy '*' --max-time 15 -H 'X-Hark-Viewer: 1' -H 'Content-Type: application/json' "$@"; }
browse() { open -a "${HARK_VIEWER_BROWSER:-Firefox}" "$1" 2>/dev/null || open "$1"; }

serve() {
  api "$base/api/status" >/dev/null 2>&1 && return
  command -v "${HARK_BIN:-hark}" >/dev/null || { print -u2 "hark-viewer: ${HARK_BIN:-hark} not found (brew install phantomydn/hark/hark, or set HARK_BIN to your own build)"; exit 69; }
  mkdir -p "$HARK_VIEWER_ROOT"
  nohup python3 "$here/server.py" >> "$HARK_VIEWER_ROOT/.server.log" 2>&1 &!
  for i in {1..60}; do api "$base/api/status" >/dev/null 2>&1 && return; sleep 0.2; done
  print -u2 "hark-viewer: the page server did not start, see $HARK_VIEWER_ROOT/.server.log"; exit 70
}

case "${1:-}" in
  open) serve; browse "$base/" ;;
  stop) api -X POST "$base/api/stop"; print ;;
  quit)
    api -X POST "$base/api/stop" >/dev/null 2>&1 || true
    pkill -TERM -x hark 2>/dev/null || true       # SIGTERM lets hark finalise the audio file
    pkill -f "$here/server.py" 2>/dev/null || true
    # Wait for it to go: starting again while a capture is still finishing gives an empty recording.
    for i in {1..40}; do pgrep -x hark >/dev/null || break; sleep 0.25; done ;;
  relabel) shift; exec python3 "$here/relabel_speakers.py" "$@" ;;
  *)
    serve
    workspace="${1:-calls}"; shift || true
    out="$(python3 -c 'import json,sys; print(json.dumps({"workspace": sys.argv[1], "title": " ".join(sys.argv[2:])}))' "$workspace" "$@" | api -X POST --data-binary @- -w '\n%{http_code}' "$base/api/new")"
    code="${out##*$'\n'}"; body="${out%$'\n'*}"
    url="$(print -r -- "$body" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("url") or "")' 2>/dev/null || true)"
    if [[ "$code" != 200 ]]; then
      print -u2 "hark-viewer: not started ($code): $body"
      [[ "$code" == 409 ]] && { browse "$base/"; exit 75; }
      exit 70
    fi
    browse "$url"
    print -r -- "$body" ;;
esac
